# ============================================================
# Git 管理対象: ソースコードのみ
# ============================================================

# ---- 仮想環境 ----
amd/
venv/
.venv/

# ---- 大容量データ・モデル（完全除外） ----
data/
outputs/
*.db
*.sqlite
*.keras
*.h5
*.hdf5
*.npz
*.csv
*.xlsx

# ---- MLflow 実験ログ ----
mlruns/
mlartifacts/

# ---- Python キャッシュ ----
__pycache__/
*.py[cod]
*.pyo

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- 画像・HTML（出力物） ----
*.png
*.html

# ---- IDE / OS ----
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# ---- ビルド ----
build/
dist/
*.egg-info/

# ---- ログ / 一時ファイル ----
*.log
tmp/
temp/
PythonWorks/__pycache__/__init__.cpython-312.pyc
