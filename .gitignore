# ============================================================
# Git 管理対象: ソースコードのみ
# ============================================================

# ---- 仮想環境 ----
amd/
venv/
.venv/
venv_ndvi/
venv_rocket/

# ---- 大容量データ・モデル（完全除外） ----
# 先頭の / でルート直下の data/, outputs/ のみ除外（src/data/ は除外しない）
/data/
/outputs/
# rocket/ の実験出力（複数PCで同じ結果を生成してコンフリクトしやすいため）
/rocket/outputs/
*.db
*.sqlite
*.keras
*.h5
*.hdf5
*.npz
*.csv
*.xlsx

# ---- MLflow 実験ログ ----
mlruns/
mlartifacts/

# ---- Python キャッシュ ----
__pycache__/
*.py[cod]
*.pyo

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- 画像・HTML（出力物） ----
*.png
*.html

# ---- IDE / OS ----
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# ---- ビルド ----
build/
dist/
*.egg-info/

# ---- ログ / 一時ファイル ----
*.log
tmp/
temp/
PythonWorks/__pycache__/__init__.cpython-312.pyc

# ---- 参考論文PDF（著作権のため公開しない） ----
rocket/docs/papers/
